# ==============================================================================
# CRM Kauezao - variaveis do monorepo (docker compose le este arquivo)
# ==============================================================================

# ---------- Banco de dados (PostgreSQL) ----------
DB_NAME=crm_kauezao
DB_USER=kauezao
DB_PASSWORD=troque-esta-senha

# Porta publicada no host.
DB_PORT_EXTERNAL=5432

# ---------- Back-end (Spring Boot) ----------
BACKEND_PORT=8080

# Origens liberadas no CORS da API (separadas por virgula).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Front-end (React + nginx) ----------
FRONTEND_PORT=3000