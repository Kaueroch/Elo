# ==============================================================================
# Elo - variaveis de ambiente do back-end (producao)
# ==============================================================================
# Em dev nada disso e obrigatorio: o application.yml tem padroes locais e a
# senha do seu banco fica em application-local.yml (fora do git).
# Em producao, exporte estas variaveis no servidor/container.

# ---------- Banco de dados (PostgreSQL) ----------
DB_URL=jdbc:postgresql://localhost:5432/crm_kauezao
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# ---------- CORS ----------
# Origens liberadas na API (separadas por virgula).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Autenticacao (JWT) ----------
# Chave que assina os tokens. OBRIGATORIO trocar em producao.
TOKEN_SECRET=troque-esta-chave-por-uma-segura
# Validade do token em segundos (padrao 24h).
TOKEN_EXPIRATION_SECONDS=86400

# Deixe false depois de criar sua conta para fechar o cadastro.
REGISTRATION_ENABLED=true
