# ==============================================================================
# Elo - variaveis do monorepo
# ==============================================================================
# Docker: copie para .env (fora do git) e rode `docker compose up -d --build`.
# Sem Docker: nada disso e obrigatorio em dev; o application.yml tem padroes
# locais e a senha do seu banco fica em application-local.yml.
# Producao: defina as mesmas variaveis no servidor/container (DB_URL no lugar
# de DB_NAME, ex.: jdbc:postgresql://host:5432/crm_kauezao).

# ---------- Banco de dados (PostgreSQL) ----------
DB_NAME=crm_kauezao
DB_USER=elo
DB_PASSWORD=troque-esta-senha
# Porta do banco no host (5433 para nao conflitar com um Postgres local).
DB_PORT_EXTERNAL=5433

# ---------- Back-end (Spring Boot) ----------
BACKEND_PORT=8080
# Origens liberadas no CORS da API (separadas por virgula).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Autenticacao (JWT) ----------
# Chave que assina os tokens. OBRIGATORIO trocar. Gere com: openssl rand -base64 48
TOKEN_SECRET=troque-esta-chave-por-uma-segura
# Validade do token em segundos (padrao 24h).
TOKEN_EXPIRATION_SECONDS=86400
# Deixe false depois de criar sua conta para fechar o cadastro.
REGISTRATION_ENABLED=true

# ---------- Front-end (React + nginx) ----------
FRONTEND_PORT=3000
