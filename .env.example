# ==============================================================================
# Elo - variaveis do monorepo (docker compose le este arquivo)
# ==============================================================================

# ---------- Banco de dados (PostgreSQL) ----------
DB_NAME=crm_kauezao
DB_USER=kauezao
DB_PASSWORD=troque-esta-senha

# Porta publicada no host.
DB_PORT_EXTERNAL=5432

# ---------- Back-end (Spring Boot) ----------
BACKEND_PORT=8080

# Origens liberadas no CORS da API (separadas por virgula).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Autenticacao (JWT) ----------
# Chave usada para assinar/validar os tokens. OBRIGATORIO trocar em producao.
TOKEN_SECRET=troque-esta-chave-por-uma-segura
# Validade do token em segundos (padrao 24h).
TOKEN_EXPIRATION_SECONDS=86400

# ---------- Front-end (React + nginx) ----------
FRONTEND_PORT=3000