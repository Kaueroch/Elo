# VITE_API_URL: base URL da API do Elo (Spring Boot).
# Em dev o Vite faz o proxy de /api; em producao o nginx faz o proxy para backend:8080.
VITE_API_URL="/api"

# VITE_PROXY_TARGET: alvo do proxy do Vite em desenvolvimento.
# Porta onde a API Spring Boot roda (padrao 8080).
VITE_PROXY_TARGET="http://localhost:8080"
